    "from pathlib import Path\n",
    "import csv\n",
    "with (Path(DATASET_ROOT) / '/Volumes/workspace/default/retailflow_files/retailflow-v1.0.0/data/sales_batch_01.csv').open(encoding='utf-8', newline='') as stream:\n",
    "    rows = list(csv.DictReader(stream))\n",
    "matches = [row for row in rows if row['sale_id'] == sale_id]\n",
    "assert len(matches) == 1\n",
    "source_sale = matches[0]\n",
    "assert source_sale['source_row_id'] == 'B01-003'\n",
    "assert int(source_sale['quantity']) == quantity\n",
    "assert Decimal(source_sale['unit_price']) == unit_price\n",
    "assert Decimal(source_sale['discount_pct']) == discount_pct\n",
    "assert source_sale['record_version'] == '1'\n",
    "print('PASS: calculation matches B01-003 / S0003 version 1.')"
   ]
